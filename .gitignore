# Claude Code workspace metadata (worktrees, settings, etc.)
.claude/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Training artefacts — captures は raw audio で巨大なので除外、runs/ は学習済み
# モデル + 解析図表を共有資産としてリポに含める方針。
# ただし docs/ のテストレポートが参照する analysis/ 配下の PNG 図表だけは
# 例外的に追跡する (wav・csv 等の生データは引き続き除外)。
# 注: captures/ をディレクトリごと除外すると git 仕様で配下を再包含できないため、
#     「中身を除外 → ディレクトリと analysis PNG だけ再包含」の形にしている。
**/captures/**
!**/captures/**/
!**/captures/**/analysis/**/*.png
*.wav
labels.csv

# v21 以降 (アクリル天井 era) の各測定について、各条件 (state) 1 frame だけ
# 代表 wav を解析用にコミット対象とする。代表は各 state ディレクトリ先頭の
# frame_000000.wav 固定。残り frame / 生データ本体は引き続き除外。
# 対象: 学習 train_v21〜v25 (+ 将来の v26 以降) と 検証 eval_v1。
# passive_v1 (ambient ノイズ録音) は対象外。≤v20 (旧ハード) も対象外。
# 注: これらは上の *.wav より後に置くこと (後勝ちで再包含されるため)。
!**/captures/full_32_train_v2[1-9]/**/frame_000000.wav
!**/captures/full_32_train_v[3-9][0-9]/**/frame_000000.wav
!**/captures/full_32_eval_v1/**/frame_000000.wav

# Host build outputs from firmware/host_build (regenerated by make)
firmware/host_build/*.so
firmware/host_build/*.dll
firmware/host_build/*.dylib
firmware/host_build/*.a

# MCUXpresso for VS Code build / SDK-clone artefacts under each project
# (CMakePresets → ${fileDir}/<preset>/ holds compile output;
#  __repo__/ holds west-managed clones of mcuxsdk + manifests.)
**/debug/
**/release/
**/flash_debug/
**/flash_release/
**/__repo__/
**/mcuxsdk/
**/manifests/
**/.west/

# MCUXpresso for VS Code per-machine config (contains absolute SDK / toolchain /
# user-home paths that differ per developer). Created by the extension's Import
# Project wizard on first open of each project; should not live in version
# control. See firmware/README.md "ビルド手順" for first-clone bring-up.
# .vscode/{c_cpp_properties,launch,settings,tasks,mcuxpresso-tools}.json are all
# regenerated by the wizard, so the entire per-project .vscode/ is ignored.
firmware/projects/*/.vscode/
firmware/projects/*/mcux_include.json

# Editor / OS detritus
.DS_Store
Thumbs.db
*.swp
*~

# Conda lock / env exports (kept out by default — regenerate per machine)
pc/environment-lock.yml
pc/env-conda.yml
pc/env-pip.txt
